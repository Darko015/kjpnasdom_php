Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^SAJT - [F,L]
    RewriteRule ^vesti/([A-Za-z0-9_-]+)/?$ vesti.php?slug=$1 [L,QSA]
    RewriteRule ^arhiva-obavestenja/?$ arhiva-obavestenja.php [L,QSA]
    RewriteRule ^program-poslovanja/?$ program-poslovanja.php [L,QSA]
    RewriteRule ^izvestaji-poslovanja/?$ izvestaji-poslovanja.php [L,QSA]
    RewriteRule ^javne-nabavke/?$ javne-nabavke.php [L,QSA]
    RewriteRule ^dokumenti/?$ dokumenti.php [L,QSA]
    RewriteRule ^o-preduzecu/?$ o-preduzecu.php [L,QSA]
    RewriteRule ^usluge/?$ usluge.php [L,QSA]
    RewriteRule ^kontakt/?$ kontakt.php [L,QSA]
    RewriteRule ^robots\.txt$ robots.php [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
</IfModule>

<FilesMatch "(^\.|meta\.json$|\.go$|go\.mod$|go\.sum$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
